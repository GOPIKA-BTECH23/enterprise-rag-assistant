# Copy this file to backend/.env and fill in real values. Never commit backend/.env.

# "groq" (default, hosted) or "lmstudio" (local LM Studio server)
LLM_PROVIDER=groq

# Required when LLM_PROVIDER=groq. Create one at https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here

# Optional. Defaults: openai/gpt-oss-20b (groq), mistral-7b-instruct-v0.2@q4_0 (lmstudio)
# LLM_MODEL=openai/gpt-oss-20b

# Optional. Only used when LLM_PROVIDER=lmstudio
# LM_STUDIO_URL=http://127.0.0.1:1234/v1/chat/completions

# Secret used to sign login tokens. Use a long random string, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string

# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional. Set to "production" to make a missing JWT_SECRET a startup error
# (automatic on Render, which sets RENDER=true)
# APP_ENV=production

# Optional. SQLite file location (default: backend/enterprise_rag.db)
# DB_PATH=
